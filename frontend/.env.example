# frontend/.env is committed with VITE_API_BASE_URL=http://127.0.0.1:5000
# already set, so local dev works out of the box -- no setup needed here.
# Only edit .env if you're running a non-default setup: a backend on a
# different port, or a deployed agent / model backend, e.g.:
# VITE_API_BASE_URL=https://your-agent-runtime-url.run.app
VITE_API_BASE_URL=http://127.0.0.1:5000
