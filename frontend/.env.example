# REQUIRED. There is no demo/mock mode -- without this set, screening and
# attachment uploads (POST requests) fail with a plain, empty-body 404 from
# Vite's own dev server, and other API calls (GET requests, e.g. dashboard
# session history) fail differently, as a JSON-parse error on Vite's HTML
# fallback page. Point this at your backend, e.g. for local dev:
# VITE_API_BASE_URL=http://127.0.0.1:5000
# or your deployed agent / model backend, e.g.:
# https://your-agent-runtime-url.run.app
VITE_API_BASE_URL=http://localhost:8000/
