# FastAPI Configuration
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
# For Docker setup, use the container database service name or localhost if running locally
DATABASE_URL=postgresql://postgres:password@localhost:5432/parkinsons

# Google Gemini API Key (Required for clinical explainer agent)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret (Required for auth). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_secret
